static void clear_memo(Nav*n){if(n->memo_count)zero_bytes(n->memo_slots,sizeof(n->memo_slots));n->memo_count=0;n->memo_valid=0;n->scope=0;}
static uint64_t los_hash(V2 a,V2 b,double r){union{float f;uint32_t u;}v;union{double f;uint64_t u;}d;uint64_t h=1469598103934665603ULL;const float f[]={a.x,a.y,b.x,b.y};for(int i=0;i<4;i++){v.f=f[i]==0?0:f[i];h=(h^v.u)*1099511628211ULL;}d.f=r==0?0:r;return(h^d.u)*1099511628211ULL;}
static int memo_find(Nav*n,V2 a,V2 b,double r,int*value){uint32_t k=(uint32_t)los_hash(a,b,r)&8191;for(int j=0;j<8192;j++,k=(k+1)&8191){uint32_t slot=n->memo_slots[k];if(!slot)return 0;Los*q=&n->memo[slot-1];if(samev(q->a,a)&&samev(q->b,b)&&q->r==r){*value=q->visible;return 1;}}return 0;}
static void memo_put(Nav*n,V2 a,V2 b,double r,int value){if(n->memo_count>=4096)return;uint32_t k=(uint32_t)los_hash(a,b,r)&8191;while(n->memo_slots[k])k=(k+1)&8191;n->memo[n->memo_count]=(Los){a,b,r,value};n->memo_slots[k]=++n->memo_count;}
static int cell_span_ready(Context*c,int lx,int ly,int hx,int hy){if(hx-lx>8||hy-ly>8)return 0;Terrain*t=c->terrain;for(int y=ly;y<=hy;y++)for(int x=lx;x<=hx;x++){int found=0;for(int64_t i=0;i<t->nc;i++)if(t->cells[i].x==x&&t->cells[i].y==y){found=1;break;}if(!found)return 0;}return 1;}
static int domain_ready(Context*c,V2 p,V2 d,double r){R2 b=swept(p,d,r);V2 end=add(b.p,b.s);int lx=floord((double)b.p.x/768),ly=floord((double)b.p.y/768),hx=floord(((double)end.x-(b.s.x>0?0.0001:0))/768),hy=floord(((double)end.y-(b.s.y>0?0.0001:0))/768);if(hx-lx>8||hy-ly>8)return 0;V2 next=add(p,d),upper={p.x>next.x?p.x:next.x,p.y>next.y?p.y:next.y};R2 endpoint=swept(upper,(V2){0,0},r);end=add(endpoint.p,endpoint.s);int ex=floord(((double)end.x-(endpoint.s.x>0?0.0001:0))/768),ey=floord(((double)end.y-(endpoint.s.y>0?0.0001:0))/768);if(ex>hx)hx=ex;if(ey>hy)hy=ey;
 /* Baseline bounds >8 is checked before endpoint high-edge union only. */
 Terrain*t=c->terrain;for(int y=ly;y<=hy;y++)for(int x=lx;x<=hx;x++){int found=0;for(int64_t i=0;i<t->nc;i++)if(t->cells[i].x==x&&t->cells[i].y==y){found=1;break;}if(!found)return 0;}return 1;}
static int fraction_visible(Context*c,V2 a,V2 b,double r){V2 d=sub(b,a);candidates(c,swept(a,d,r));Terrain*t=c->terrain;for(uint32_t j=0;j<t->selected_count;j++){Prop*p=&t->props[t->selected[j]];if((p->mask&3)&&slab(a,d,grow(p->box,r))<1)return 0;}return 1;}
static int visible(Context*c,V2 a,V2 b,double r){Nav*n=c->nav;if(n->scope&&(n->memo_epoch!=c->terrain->epoch||n->query_failure||c->world_error))clear_memo(n);int value=0;if(n->scope&&memo_find(n,a,b,r,&value))return value;int ok=1;
 if(n->scope&&validq(a,sub(b,a),r)&&domain_ready(c,a,sub(b,a),r))value=fraction_visible(c,a,b,r);else{terrain_sweep(c,a,sub(b,a),r);ok=(int)c->sweep_ok;value=ok&&c->fraction==1;if(!ok&&!n->query_failure){n->query_failure=validq(a,sub(b,a),r)?1:2;n->query_failure_kind=1;n->query_failure_position=a;}}
 if(n->scope){if(ok)memo_put(n,a,b,r,value);else clear_memo(n);}return value;
}
static int prepared_ready(Context*c,V2 start,V2*points,int count,double r){Nav*n=c->nav;if(!count||!n->scope||n->query_failure||c->world_error||n->memo_epoch!=c->terrain->epoch||!__builtin_isfinite(r)||r<0||r>32||!finite_v(start)||absf32(start.x)>8192||absf32(start.y)>8192)return 0;double lx=start.x,hx=start.x,ly=start.y,hy=start.y;for(int i=0;i<count;i++){V2 p=points[i];if(!finite_v(p)||absf32(p.x)>8192||absf32(p.y)>8192)return 0;if(p.x<lx)lx=p.x;if(p.x>hx)hx=p.x;if(p.y<ly)ly=p.y;if(p.y>hy)hy=p.y;}double pad=r+1;return cell_span_ready(c,floord((lx-pad)/768),floord((ly-pad)/768),floord((hx+pad)/768),floord((hy+pad)/768));}
static int visible_prepared(Context*c,V2 a,V2 b,double r){int value;if(memo_find(c->nav,a,b,r,&value))return value;value=fraction_visible(c,a,b,r);memo_put(c->nav,a,b,r,value);return value;}
