/* Local-route kernel. Geometry ownership is supplied, never inferred. */
typedef struct {V2 a,b;double r;int visible;} Los;
typedef struct {int64_t identity,revision,tick;V2 origin,goal;double radius;int clearance,target,target_set,precise_set;unsigned char flags[576];int32_t distances[576];int seeds[4],seed_count;int inputs_set;int64_t input_epoch;} Grid;
struct Nav {Grid*grids[512];int count,grid_builds,route_builds;int requested_cell;int64_t tick,request_epoch;int request_set;int ok,error,query_failure,query_failure_kind;V2 query_failure_position;Grid*current;V2 points[36992],route_scratch[36992];int point_count;double total_length;Los memo[4096];uint32_t memo_slots[8192];int memo_count,memo_valid,scope;int64_t memo_tick,memo_epoch;};
static void drop_nav(Nav*n){if(!n)return;for(int i=0;i<n->count;i++)tracked_free(n->grids[i]);tracked_free(n);}
static Nav*ensure_nav(Context*c){if(!c->nav)c->nav=zalloc(sizeof(Nav));return c->nav;}
static int set_meta(Context*c,int64_t i,int64_t identity,int64_t revision){Terrain*t=c->pending;if(!t||i<0||i>=t->nc||identity<0||revision<0){if(t)t->poisoned=1;c->admission=1;return 0;}for(int64_t j=0;j<t->nc;j++)if(j!=i&&t->cells[j].meta_set&&t->cells[j].identity==identity){t->poisoned=1;c->admission=1;return 0;}t->cells[i].identity=identity;t->cells[i].revision=revision;t->cells[i].meta_set=1;return 1;}
static int set_owner(Context*c,int64_t i,int64_t cell){Terrain*t=c->pending;if(!t||i<0||i>=t->np||cell<0||cell>=t->nc){if(t)t->poisoned=1;c->admission=1;return 0;}t->props[i].owner=(int)cell;t->props[i].owner_set=1;return 1;}
static int nav_admitted(Terrain*t){if(!t)return 0;for(int64_t i=0;i<t->nc;i++)if(!t->cells[i].meta_set)return 0;for(int64_t i=0;i<t->np;i++)if(!t->props[i].owner_set)return 0;return 1;}
static int nav_request(Context*c,int64_t cell,int64_t tick){if(!nav_admitted(c->terrain)||cell<0||cell>=c->terrain->nc||tick<0)return 0;Nav*n=ensure_nav(c);if(!n)return 0;n->ok=0;n->error=0;n->point_count=0;n->total_length=0;n->query_failure=0;n->query_failure_kind=0;n->current=0;n->requested_cell=(int)cell;n->tick=tick;n->request_epoch=c->terrain->epoch;n->request_set=1;return 1;}
static V2 cell_origin(Cell*c){return(V2){(float)(c->x*768),(float)(c->y*768)};}
static int samev(V2 a,V2 b){return a.x==b.x&&a.y==b.y;}
static V2 center(int id,V2 o){return add(o,(V2){(float)((id%24)*32+16),(float)((id/24)*32+16)});}
static int neighbors(int id,int*out){int n=0;if(id>=24)out[n++]=id-24;if(id%24>0)out[n++]=id-1;if(id%24<23)out[n++]=id+1;if(id<552)out[n++]=id+24;return n;}
static int clearance(double r){const int classes[]={8,16,18,20,24,28,30,32};if(!__builtin_isfinite(r)||r<0)return -1;for(int i=0;i<8;i++)if(classes[i]>=r)return classes[i];return -1;}
#include "direction_support.inc"
static void nav_prune(Context*c){Nav*n=c->nav;Terrain*t=c->terrain;for(int i=0;i<n->count;){Grid*g=n->grids[i];int found=0;for(int64_t j=0;j<t->nc;j++)if(t->cells[j].identity==g->identity&&samev(cell_origin(&t->cells[j]),g->origin)){found=1;break;}if(found){i++;continue;}tracked_free(g);for(int j=i+1;j<n->count;j++)n->grids[j-1]=n->grids[j];n->count--;}}
static Grid*grid_for(Context*c,int cell,int cl){Nav*n=c->nav;Terrain*t=c->terrain;Cell*ch=&t->cells[cell];int slot=-1;for(int i=0;i<n->count;i++)if(n->grids[i]->identity==ch->identity&&n->grids[i]->clearance==cl){slot=i;break;}if(slot>=0&&n->grids[slot]->revision==ch->revision)return n->grids[slot];if(slot<0&&n->count>=512){n->error=4;return 0;}Grid*g=zalloc(sizeof(Grid));if(!g){n->error=4;return 0;}g->identity=ch->identity;g->revision=ch->revision;g->origin=cell_origin(ch);g->clearance=cl;for(int i=0;i<576;i++){g->flags[i]=1;g->distances[i]=-1;}
 for(int64_t p=0;p<t->np;p++){Prop*prop=&t->props[p];if(prop->owner!=cell||!prop->mask)continue;R2 box=grow(prop->box,cl);for(int i=0;i<576;i++)if(inside_box(center(i,g->origin),box))g->flags[i]=0;}
 if(slot<0){slot=n->count++;}else tracked_free(n->grids[slot]);n->grids[slot]=g;n->grid_builds++;return g;}
static void distances(Context*c,Grid*g,int target,V2 goal,double r){Nav*n=c->nav;n->route_builds++;int queue[576],tail=0;
 if(g->flags[target]&&visible(c,center(target,g->origin),goal,r)){queue[tail++]=target;}else{int nb[4],nn=neighbors(target,nb);for(int j=0;j<nn;j++){int id=nb[j];if(g->flags[id]&&visible(c,center(id,g->origin),goal,r))queue[tail++]=id;}}
 int eligible=!n->query_failure&&!c->world_error;int reuse=eligible&&g->inputs_set&&g->input_epoch==c->terrain->epoch&&g->seed_count==tail;for(int i=0;i<tail&&reuse;i++)if(g->seeds[i]!=queue[i])reuse=0;
 g->inputs_set=eligible;g->input_epoch=c->terrain->epoch;g->seed_count=tail;for(int i=0;i<tail;i++)g->seeds[i]=queue[i];
 if(!reuse){for(int i=0;i<576;i++)g->distances[i]=-1;for(int i=0;i<tail;i++)g->distances[queue[i]]=0;int head=0;while(head<tail){int id=queue[head++],nb[4],nn=neighbors(id,nb);for(int j=0;j<nn;j++){int next=nb[j];if(g->flags[next]&&g->distances[next]<0){g->distances[next]=g->distances[id]+32;queue[tail++]=next;}}}}
 g->target=target;g->target_set=1;g->tick=n->tick;g->goal=goal;g->radius=r;g->precise_set=1;
}
static int safe_smoothing(Context*c,V2 start,V2*points,int first,int count,double r){if(c->nav->query_failure||first<0||first>=count)return 0;int lx=0,ly=0,hx=0,hy=0;for(int i=first;i<count;i++){V2 d=sub(points[i],start);if(!validq(start,d,r))return 0;R2 b=swept(start,d,r);V2 e=add(b.p,b.s);int ax=floord((double)b.p.x/768),ay=floord((double)b.p.y/768),bx=floord(((double)e.x-(b.s.x>0?0.0001:0))/768),by=floord(((double)e.y-(b.s.y>0?0.0001:0))/768);if(i==first||ax<lx)lx=ax;if(i==first||ay<ly)ly=ay;if(i==first||bx>hx)hx=bx;if(i==first||by>hy)hy=by;}
 if(hx-lx>8||hy-ly>8)return 0;Terrain*t=c->terrain;for(int y=ly;y<=hy;y++)for(int x=lx;x<=hx;x++){int found=0;for(int64_t j=0;j<t->nc;j++)if(t->cells[j].x==x&&t->cells[j].y==y){found=1;break;}if(!found)return 0;}return 1;
}
static void smooth(Context*c,V2 start,V2*points,int count,double r){Nav*n=c->nav;int prepared=prepared_ready(c,start,points,count,r);V2 current=start;int index=0;n->point_count=0;while(index<count){int best=index;if(prepared||safe_smoothing(c,current,points,index,count,r)){for(int next=count-1;next>=index;next--)if(prepared?visible_prepared(c,current,points[next],r):visible(c,current,points[next],r)){best=next;break;}}else{for(int next=index;next<count;next++)if(visible(c,current,points[next],r))best=next;}n->points[n->point_count++]=points[best];current=points[best];index=best+1;}}
static V2 finish_route(Context*c,V2 start){Nav*n=c->nav;n->ok=1;n->error=0;n->total_length=0;V2 current=start;for(int i=0;i<n->point_count;i++){n->total_length+=(double)length(sub(n->points[i],current));current=n->points[i];}if(!n->point_count)return(V2){0,0};V2 d=sub(n->points[0],start);float len=length(d);return len==0?(V2){0,0}:(V2){d.x/len,d.y/len};}
static V2 local_route(Context*c,V2 start,V2 goal,double r){Nav*n=ensure_nav(c);V2 zero={0,0};if(!n)return zero;n->ok=0;n->point_count=0;n->total_length=0;n->current=0;if(!n->request_set||!nav_admitted(c->terrain)||n->request_epoch!=c->terrain->epoch){n->error=4;return zero;}int cl=clearance(r);if(cl<0){n->error=1;return zero;}if(!validq(start,sub(goal,start),r)){n->error=4;return zero;}nav_prune(c);Cell*ch=&c->terrain->cells[n->requested_cell];
 for(int i=0;i<n->count;i++){Grid*g=n->grids[i];if(g->identity==ch->identity&&g->clearance==cl&&(!g->precise_set||!samev(g->goal,goal)||g->radius!=r))g->target_set=0;}
 if(visible(c,start,goal,r)){n->points[0]=goal;n->point_count=1;return finish_route(c,start);}Grid*g=grid_for(c,n->requested_cell,cl);if(!g)return zero;n->current=g;V2 gl=sub(goal,g->origin);int gx=floord((double)gl.x/32),gy=floord((double)gl.y/32);if(gx<0)gx=0;if(gx>23)gx=23;if(gy<0)gy=0;if(gy>23)gy=23;int target=gy*24+gx;
 if(!g->target_set||g->target!=target||n->tick-g->tick>=12||n->tick<g->tick)distances(c,g,target,goal,r);
 V2 sl=sub(start,g->origin);int sx=floord((double)sl.x/32),sy=floord((double)sl.y/32);if(sx<0)sx=0;if(sx>23)sx=23;if(sy<0)sy=0;if(sy>23)sy=23;int best=-1;double best_cost=__builtin_inf();for(int y=(sy>0?sy-1:0);y<(sy+2<24?sy+2:24);y++)for(int x=(sx>0?sx-1:0);x<(sx+2<24?sx+2:24);x++){int id=y*24+x;if(g->distances[id]<0)continue;V2 p=center(id,g->origin);double cost=(double)length(sub(p,start))+g->distances[id];if(cost<best_cost&&visible(c,start,p,r)){best=id;best_cost=cost;}}
 if(best<0){n->error=2;return zero;}V2 points[578];int count=1,cursor=best,guard=0;points[0]=center(best,g->origin);while(g->distances[cursor]>0){if(++guard>576){n->error=2;return zero;}int next=-1,nb[4],nn=neighbors(cursor,nb);for(int j=0;j<nn;j++){int k=nb[j];if(g->distances[k]>=0&&g->distances[k]<g->distances[cursor]&&(next<0||g->distances[k]<g->distances[next]||(g->distances[k]==g->distances[next]&&k<next)))next=k;}if(next<0){n->error=2;return zero;}points[count++]=center(next,g->origin);cursor=next;}
 if(!visible(c,points[count-1],goal,r)){n->error=2;return zero;}points[count++]=goal;smooth(c,start,points,count,r);return finish_route(c,start);
}
static int nav_set_tick(Context*c,int64_t tick){if(!nav_admitted(c->terrain)||tick<0)return 0;Nav*n=ensure_nav(c);if(!n)return 0;n->tick=tick;n->request_epoch=c->terrain->epoch;n->request_set=1;n->query_failure=0;n->query_failure_kind=0;n->scope=0;n->ok=0;n->error=0;n->point_count=0;n->total_length=0;n->current=0;return 1;}
static int nav_walkable(Context*c,V2 p,double r){if(!covered(c,swept(p,(V2){0,0},r))){if(!c->nav->query_failure){c->nav->query_failure=1;c->nav->query_failure_kind=2;}return 0;}return walkable(c,p,r);}
static int find_cell(Terrain*t,int x,int y){for(int64_t i=0;i<t->nc;i++)if(t->cells[i].x==x&&t->cells[i].y==y)return(int)i;return -1;}
static V2 direction_impl(Context*c,V2 start,V2 goal,double r){Nav*n=c->nav;Terrain*t=c->terrain;V2 zero={0,0};int cl=clearance(r);if(cl<0){n->error=1;return zero;}if(!validq(start,sub(goal,start),r)){n->error=4;return zero;}nav_prune(c);if(!nav_walkable(c,start,r)||!nav_walkable(c,goal,r)){n->error=2;return zero;}if(visible(c,start,goal,r)){n->points[0]=goal;n->point_count=1;return finish_route(c,start);}
 int from=find_cell(t,floord((double)start.x/768),floord((double)start.y/768)),to=find_cell(t,floord((double)goal.x/768),floord((double)goal.y/768));if(from<0||to<0){n->error=3;return zero;}int prev[64],queue[64],path[64],head=0,tail=1;for(int i=0;i<64;i++)prev[i]=-1;prev[from]=from;queue[0]=from;const int dx[]={0,-1,1,0},dy[]={-1,0,0,1};while(head<tail){int cur=queue[head++];if(cur==to)break;for(int k=0;k<4;k++){int next=find_cell(t,t->cells[cur].x+dx[k],t->cells[cur].y+dy[k]);if(next>=0&&prev[next]<0){prev[next]=cur;queue[tail++]=next;}}}if(prev[to]<0){n->error=3;return zero;}int count=0,cursor=to;while(cursor!=from){path[count++]=cursor;cursor=prev[cursor];}path[count++]=from;for(int i=0;i<count/2;i++){int x=path[i];path[i]=path[count-1-i];path[count-1-i]=x;}
 int total=0;V2 current=start;for(int i=0;i<count;i++){V2 target=goal;if(i+1<count){V2 origin=cell_origin(&t->cells[path[i]]),change=sub(cell_origin(&t->cells[path[i+1]]),origin);float len=length(change);V2 unit={change.x/len,change.y/len};target=add(add(origin,(V2){384,384}),scale(unit,384));}n->requested_cell=path[i];local_route(c,current,target,r);if(!n->ok)return zero;for(int j=0;j<n->point_count;j++)n->route_scratch[total++]=n->points[j];current=target;}
 smooth(c,start,n->route_scratch,total,r);return finish_route(c,start);
}
static V2 nav_direction(Context*c,V2 start,V2 goal,double r){Nav*n=ensure_nav(c);V2 zero={0,0};if(!n)return zero;n->ok=0;n->error=0;n->point_count=0;n->total_length=0;n->current=0;if(!n->request_set||!nav_admitted(c->terrain)||n->request_epoch!=c->terrain->epoch){n->error=4;return zero;}
 if(n->query_failure||c->world_error){clear_memo(n);}else{if(!n->memo_valid||n->memo_epoch!=c->terrain->epoch||n->memo_tick>n->tick||(n->memo_tick<n->tick&&n->memo_count>=4096))clear_memo(n);n->memo_valid=1;n->scope=1;n->memo_tick=n->tick;n->memo_epoch=c->terrain->epoch;}
 V2 result=direction_impl(c,start,goal,r);if(n->query_failure||c->world_error)clear_memo(n);n->scope=0;return result;
}
